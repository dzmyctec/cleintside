<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_new_player"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/playerTeamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_team_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/playerNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_name"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerAgeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_age"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerPositionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_position"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerGoalsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_goals"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerAssistsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_assists"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerAppearancesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_appearances"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/playerNationalityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_nationality"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelPlayerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/savePlayerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_player"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView> 